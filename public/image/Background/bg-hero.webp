<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <radialGradient id="heroGlow1" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#a855f7" stop-opacity="0.35"/>
      <stop offset="50%" stop-color="#3b82f6" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#030308" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="heroGlow2" cx="75%" cy="30%" r="40%">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#030308" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
      <path d="M 60 0 L 0 0 0 60" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
      <circle cx="60" cy="60" r="1.5" fill="rgba(168,85,247,0.3)"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="#030308"/>
  <rect width="100%" height="100%" fill="url(#grid)"/>
  <rect width="100%" height="100%" fill="url(#heroGlow1)"/>
  <rect width="100%" height="100%" fill="url(#heroGlow2)"/>
  <path d="M -100 800 Q 400 400 1000 700 T 2000 300" fill="none" stroke="rgba(168,85,247,0.15)" stroke-width="2"/>
  <path d="M -100 850 Q 500 450 1100 750 T 2000 350" fill="none" stroke="rgba(6,182,212,0.15)" stroke-width="1.5"/>
</svg>